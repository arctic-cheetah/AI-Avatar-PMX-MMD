{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Yidhari: Build VSIX",
      "type": "process",
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": ["run", "package"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
